{
  "name": "backend",
  "version": "1.0.0",
  "description": "Voice agent backend",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run prisma:db:dev && npm run prisma:generate:dev && nodemon --watch src --ext ts,js,json --exec 'npx tsx --env-file .env.dev src/main.ts'",
    "dev:prod": "npm run prisma:migrate:prod && npm run prisma:generate:prod && nodemon --watch src --ext ts,js,json --exec 'npx tsx --env-file .env.prod src/main.ts'",
    "prisma:db:dev": "npx tsx --env-file .env.dev -e \"import { execSync } from 'child_process'; execSync('npx prisma db pull', { stdio: 'inherit' });\"",
    "prisma:generate:dev": "npx tsx --env-file .env.dev -e \"import { execSync } from 'child_process'; execSync('npx prisma generate', { stdio: 'inherit' });\"",
    "prisma:migrate:prod": "npx tsx --env-file .env.prod -e \"import { execSync } from 'child_process'; execSync('npx prisma migrate deploy', { stdio: 'inherit' });\"",
    "prisma:studio": "prisma studio",
    "build": "tsc",
    "start": "NODE_ENV=dev node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "^2.1.2",
    "@google/genai": "^1.25.0",
    "@huggingface/inference": "^4.11.3",
    "@pinecone-database/pinecone": "^6.1.2",
    "@prisma/client": "^6.17.1",
    "@supabase/supabase-js": "^2.75.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express-validator": "^2.20.33",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailgen": "^2.0.7",
    "@types/morgan": "^1.9.10",
    "@types/nodemailer": "^7.0.2",
    "@types/request-ip": "^0.0.41",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "alawmulaw": "^6.0.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.24",
    "mailgen": "^2.0.32",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "request-ip": "^3.3.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.3",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "eslint": "^9.37.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
